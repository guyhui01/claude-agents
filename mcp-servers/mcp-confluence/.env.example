# MCP Server Confluence — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs

# URL de ton instance Confluence
# Confluence Cloud  : https://ton-domaine.atlassian.net
# Confluence Server : https://confluence.ton-entreprise.com
CONFLUENCE_BASE_URL=https://ton-domaine.atlassian.net

# Email du compte Confluence (même que Jira si Atlassian Cloud)
CONFLUENCE_EMAIL=guy.hui@adservio.fr

# Même API token que Jira si Atlassian Cloud
# https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=ton_api_token_ici

# Espace Confluence par défaut (ex: PROJ, DOC, CONSULT)
# Laisser vide pour toujours le préciser dans les outils
CONFLUENCE_DEFAULT_SPACE=CONSULT
