# MCP Server Jira — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs

# URL de ton instance Jira
# Jira Cloud   : https://ton-domaine.atlassian.net
# Jira Server  : https://jira.ton-entreprise.com
JIRA_BASE_URL=https://ton-domaine.atlassian.net

# Email du compte Jira (celui utilisé pour l'API token)
JIRA_EMAIL=guy.hui@adservio.fr

# API Token Jira Cloud : https://id.atlassian.com/manage-profile/security/api-tokens
# Jira Server : mot de passe ou token personnel
JIRA_API_TOKEN=ton_api_token_ici

# Clé du projet par défaut (ex: PROJ, DIGI, IA2026)
JIRA_PROJECT_KEY=PROJ

# Champ story points (Jira Cloud = customfield_10016 par défaut)
# Si story_points ne fonctionne pas, chercher le bon ID dans :
# GET /rest/api/3/field → chercher "Story Points" ou "Story point estimate"
JIRA_STORY_POINTS_FIELD=customfield_10016
