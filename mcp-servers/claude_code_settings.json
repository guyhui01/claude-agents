{
  "_comment": "Example MCP configuration for Claude Code CLI.",
  "_instructions": [
    "1. Copy this file to: ~/.claude/settings.json",
    "2. Replace the values between <> with your real values",
    "3. Adjust the paths if the repo is not located in /Users/guyhui/CLAUDE/claude-agents/",
    "4. Restart Claude Code CLI to apply the changes",
    "5. Verify with: claude mcp list"
  ],
  "mcpServers": {
    "jira": {
      "command": "npx",
      "args": [
        "tsx",
        "/Users/guyhui/CLAUDE/claude-agents/mcp-servers/mcp-jira/server.ts"
      ],
      "env": {
        "JIRA_BASE_URL": "https://<your-domain>.atlassian.net",
        "JIRA_EMAIL": "<your-email>",
        "JIRA_API_TOKEN": "<your-jira-api-token>",
        "JIRA_PROJECT_KEY": "<PROJECT-KEY>",
        "JIRA_STORY_POINTS_FIELD": "customfield_10016"
      }
    },
    "confluence": {
      "command": "npx",
      "args": [
        "tsx",
        "/Users/guyhui/CLAUDE/claude-agents/mcp-servers/mcp-confluence/server.ts"
      ],
      "env": {
        "CONFLUENCE_BASE_URL": "https://<your-domain>.atlassian.net",
        "CONFLUENCE_EMAIL": "<your-email>",
        "CONFLUENCE_API_TOKEN": "<your-confluence-api-token>",
        "CONFLUENCE_DEFAULT_SPACE": "<SPACE-KEY>"
      }
    },
    "workflow-log": {
      "command": "npx",
      "args": [
        "tsx",
        "/Users/guyhui/CLAUDE/claude-agents/mcp-servers/mcp-workflow-log/server.ts"
      ],
      "env": {
        "WORKFLOW_LOG_PATH": "/Users/guyhui/CLAUDE/claude-agents/mcp-servers/mcp-workflow-log/workflow_log.json"
      }
    }
  }
}
